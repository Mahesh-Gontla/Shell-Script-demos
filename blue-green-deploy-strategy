pipeline{
    agent any {
    tools{
        maven 'maven-3'
    }
    environment{
        SCANNER_HOME= tool 'sonar-scanner'
    }
    stages{
        stage("git checkout stage"){ #if it is private repo means have to add credentials
            steps{ #find out issues at early stages
                    git checkout through generator
                }
            }
        stage("compile"){
            steps{
                sh 'mvn compile'
                }
            }
        stage("Tests"){
            steps{
                sh 'mvn test -DskipTests=true'
               }
            }
        }
        stage("Trivy FS Scan"){
            steps{
                sh 'trivy fs --format table -o fs.html'
            }
        }
        stage("sonarqube analysis"){
            steps{
                withSonarQubeEnv('sonar'){
                    sh '$SCANNER_HOME/bin/sonar-scanner'
                }
            }
        }
        stage("")
    }
}



